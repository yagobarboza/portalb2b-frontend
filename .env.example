# ─────────────────────────────────────────────
# nydB2B Frontend — Variáveis de ambiente
# Copie para `.env.local` e preencha os valores.
# NUNCA commite `.env.local` (pode conter segredos).
# ─────────────────────────────────────────────

# URL base da API do backend (FastAPI).
# Em dev, o proxy Vite roteia /api até esta origem.
# Em produção, é OBRIGATÓRIA — o build falha sem ela.
VITE_API_URL=http://localhost:8000/api/v1