# URL base da API do backend (FastAPI).
# - Desenvolvimento: http://localhost:8000/api/v1
# - Produção: https://api.suaempresa.com/api/v1  (OBRIGATÓRIA em PROD)
# Em dev, o Vite faz proxy de /api para esta origem (mitiga CORS e
# garante o tráfego de cookies HttpOnly).
VITE_API_URL=http://localhost:8000/api/v1